+@router.post(
+    "",
+    status_code=201,
+    dependencies=[Depends(require_permission_api("STUDENT_CREATE"))],
+)
+def create_student(
+    payload: StudentCreateRequest,
+    current_user: User = Depends(get_current_user),
+    session: Session = Depends(get_db),
+):
+    """Create a student with satellites + class assignment (single
+    transaction). The matricule is auto-generated when omitted."""
+    est_id = _current_establishment(session, current_user, payload.establishment_id)
+
+    matricule = (payload.matricule or "").strip() or _generate_matricule(
+        session, est_id
+    )
+    dup = (
+        session.query(Student.id)
+        .filter(
+            Student.establishment_id == est_id,
+            Student.matricule == matricule,
+        )
+        .first()
+    )
+    if dup:
+        raise HTTPException(
+            status_code=409, detail=f"Matricule {matricule} already exists"
+        )
+
+    student = Student(
+        public_id=str(uuid.uuid4()),
+        establishment_id=est_id,
+        matricule=matricule,
+        nom=payload.nom,
+        prenoms=payload.prenoms,
+        dob=payload.dob,
+        sexe=(payload.sexe.upper()[:1] if payload.sexe else None),
+        birth_place=payload.birth_place,
+        birth_prefecture=payload.birth_prefecture,
+        birth_region=payload.birth_region,
+        birth_country=payload.birth_country,
+        groupe=payload.groupe,
+        photo_path=payload.photo_path,
+        deleted=False,
+    )
+    session.add(student)
+    session.flush()
+
+    if payload.classroom_id is not None:
+        classroom = session.get(Classroom, payload.classroom_id)
+        if classroom is None:
+            session.rollback()
+            raise HTTPException(status_code=404, detail="Classroom not found")
+        sy_id = _current_school_year_id(session, est_id)
+        if sy_id is None:
+            session.rollback()
+            raise HTTPException(
+                status_code=404, detail="No school year found for establishment"
+            )
+        session.add(
+            StudentClassAssignment(
+                student_id=student.id,
+                classroom_id=classroom.id,
+                school_year_id=sy_id,
+                inscription_type_id=_resolve_ref_id(
+                    session, InscriptionType, payload.inscription_type
+                ),
+                student_status_id=_resolve_ref_id(
+                    session, StudentStatus, payload.status
+                ),
+                active=True,
+            )
+        )
+
+    _upsert_satellites(session, student, payload)
+
+    try:
+        session.commit()
+    except Exception as exc:
+        session.rollback()
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    session.refresh(student)
+    return _student_detail_payload(student)
+
+
+@router.patch(
+    "/{student_id}",
+    dependencies=[Depends(require_permission_api("STUDENT_CREATE"))],
+)
+def update_student(
+    student_id: int,
+    payload: StudentUpdateRequest,
+    current_user: User = Depends(get_current_user),
+    session: Session = Depends(get_db),
+):
+    """Update a student (identity, satellites, class assignment)."""
+    q = scoped_query(Student, session=session).filter(Student.id == student_id)
+    student = q.first()
+    if student is None:
+        raise HTTPException(status_code=404, detail="Student not found")
+
+    for field in (
+        "nom", "prenoms", "dob", "sexe", "birth_place", "birth_prefecture",
+        "birth_region", "birth_country", "groupe", "photo_path",
+    ):
+        value = getattr(payload, field, None)
+        if value is not None:
+            setattr(student, field, value)
+    if payload.matricule:
+        student.matricule = payload.matricule
+    if payload.sexe:
+        student.sexe = payload.sexe.upper()[:1]
+
+    if payload.classroom_id is not None:
+        classroom = session.get(Classroom, payload.classroom_id)
+        if classroom is None:
+            session.rollback()
+            raise HTTPException(status_code=404, detail="Classroom not found")
+        est_id = student.establishment_id
+        sy_id = _current_school_year_id(session, est_id)
+        if sy_id is None:
+            session.rollback()
+            raise HTTPException(
+                status_code=404, detail="No school year found for establishment"
+            )
+        # Close current active assignments, then create the new one.
+        session.query(StudentClassAssignment).filter(
+            StudentClassAssignment.student_id == student.id,
+            StudentClassAssignment.active == True,  # noqa: E712
+        ).update({"active": False}, synchronize_session=False)
+        session.add(
+            StudentClassAssignment(
+                student_id=student.id,
+                classroom_id=classroom.id,
+                school_year_id=sy_id,
+                inscription_type_id=_resolve_ref_id(
+                    session, InscriptionType, payload.inscription_type
+                ),
+                student_status_id=_resolve_ref_id(
+                    session, StudentStatus, payload.status
+                ),
+                active=True,
+            )
+        )
+
+    _upsert_satellites(session, student, payload)
+
+    try:
+        session.commit()
+    except Exception as exc:
+        session.rollback()
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    session.refresh(student)
+    return _student_detail_payload(student)
 
 
