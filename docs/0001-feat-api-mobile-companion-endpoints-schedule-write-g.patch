+def _current_establishment(session: Session, user: User, requested: int | None) -> int:
+    from getech_sms.core.security import current_establishment_id
+
+    est_id = requested or current_establishment_id()
+    if est_id is None:
+        raise HTTPException(status_code=400, detail="No establishment context")
+    return est_id
+
+
+def _generate_matricule(session: Session, establishment_id: int) -> str:
+    """Generate a unique matricule (EST-<year>-<sequence>)."""
+    year = date.today().year
+    prefix = f"EST{establishment_id}-{year}-"
+    last = (
+        session.query(Student.matricule)
+        .filter(
+            Student.establishment_id == establishment_id,
+            Student.matricule.like(f"{prefix}%"),
+        )
+        .order_by(Student.matricule.desc())
+        .first()
+    )
+    seq = 1
+    if last and last[0]:
+        try:
+            seq = int(last[0].rsplit("-", 1)[1]) + 1
+        except (ValueError, IndexError):
+            seq = 1
+    return f"{prefix}{seq:04d}"
+
+
+def _resolve_ref_id(session: Session, model, code: str | None) -> int | None:
+    if not code:
+        return None
+    row = session.query(model).filter(model.code == code.upper()).first()
+    return row.id if row else None
+
+
+def _current_school_year_id(session: Session, establishment_id: int) -> int | None:
+    sy = (
+        session.query(SchoolYear)
+        .filter(SchoolYear.establishment_id == establishment_id)
+        .order_by(SchoolYear.id.desc())
+        .first()
+    )
+    return sy.id if sy else None
+
+
+def _upsert_satellites(session: Session, student: Student, payload) -> None:
+    """Create/replace the satellite records of a student."""
+    if payload.contact is not None:
+        existing = (
+            session.query(StudentContact)
+            .filter(StudentContact.student_id == student.id)
+            .first()
+        )
+        if existing is None:
+            existing = StudentContact(student_id=student.id)
+            session.add(existing)
+        existing.phone = payload.contact.phone
+        existing.email = payload.contact.email
+        existing.address = payload.contact.address
+        existing.city = payload.contact.city
+
+    if payload.medical is not None:
+        existing = (
+            session.query(StudentMedical)
+            .filter(StudentMedical.student_id == student.id)
+            .first()
+        )
+        if existing is None:
+            existing = StudentMedical(student_id=student.id)
+            session.add(existing)
+        existing.blood_type = payload.medical.blood_type
+        existing.allergies = payload.medical.allergies
+        existing.doctor_name = payload.medical.doctor
+
+    if payload.scholastic is not None:
+        existing = (
+            session.query(StudentScholastic)
+            .filter(StudentScholastic.student_id == student.id)
+            .first()
+        )
+        if existing is None:
+            existing = StudentScholastic(student_id=student.id)
+            session.add(existing)
+        existing.previous_school = payload.scholastic.previous_school
+        if payload.scholastic.transport is not None:
+            t = payload.scholastic.transport.strip().lower()
+            existing.uses_school_transport = t in ("oui", "yes", "true", "1")
+            existing.transport_zone = payload.scholastic.transport
+
+    parents = getattr(payload, "parents", None)
+    if parents:
+        session.query(StudentParent).filter(
+            StudentParent.student_id == student.id
+        ).delete(synchronize_session=False)
+        for p in parents:
+            session.add(
+                StudentParent(
+                    student_id=student.id,
+                    role=(p.role or "PERE").upper()[:10],
+                    last_name=p.nom,
+                    first_name=p.prenoms,
+                    phone=p.phone,
+                    profession=p.profession,
+                )
+            )
+
+    guardians = getattr(payload, "guardians", None)
+    if guardians:
+        for g in guardians:
+            if g.id is not None:
+                guardian = session.get(Guardian, g.id)
+                if guardian is None:
+                    continue
+            else:
+                guardian = Guardian(
+                    establishment_id=student.establishment_id,
+                )
+                session.add(guardian)
+                session.flush()
+            if g.nom is not None:
+                guardian.last_name = g.nom
+            if g.prenoms is not None:
+                guardian.first_name = g.prenoms
+            if g.phone is not None:
+                guardian.phone = g.phone
+            if g.email is not None:
+                guardian.email = g.email
+            # Guardian n'a pas de colonne "relation" — on la range dans
+            # profession (le mobile l'affiche comme relation).
+            if g.relation is not None:
+                guardian.profession = g.relation
+            link = (
+                session.query(StudentGuardian)
+                .filter(
+                    StudentGuardian.student_id == student.id,
+                    StudentGuardian.guardian_id == guardian.id,
+                )
+                .first()
+            )
+            if link is None:
+                session.add(
+                    StudentGuardian(
+                        student_id=student.id, guardian_id=guardian.id
+                    )
+                )
+
