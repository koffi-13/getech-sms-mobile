+class ScheduleEntryCreateRequest(BaseModel):
+    """Payload for POST /schedule/entries.
+
+    The server resolves (or creates) the TimeSlot from day_of_week +
+    start_time/end_time, and reuses/creates the ScheduleSession for the
+    class subject + current school year, with conflict detection
+    (classroom + teacher) mirroring the desktop UI.
+    """
+
+    classroom_id: int
+    class_subject_id: int
+    day_of_week: int = Field(ge=1, le=6)
+    start_time: str = Field(..., description="HH:MM")
+    end_time: str = Field(..., description="HH:MM")
+    week_type: str | None = Field(None, description="A, B or null (all weeks)")
+    room: str | None = None
+
+
+class ScheduleEntryUpdateRequest(BaseModel):
+    """Payload for PUT /schedule/entries/{id}."""
+
+    time_slot_id: int | None = None
+    day_of_week: int | None = Field(None, ge=1, le=6)
+    start_time: str | None = None
+    end_time: str | None = None
+    week_type: str | None = None
+    room: str | None = None
+
+
+def _parse_hhmm(value: str) -> dtime:
+    try:
+        return datetime.strptime(value.strip(), "%H:%M").time()
+    except (ValueError, AttributeError) as exc:
+        raise HTTPException(
+            status_code=400,
+            detail=f"Invalid time {value!r} — expected HH:MM",
+        ) from exc
+
+
+def _resolve_school_year_id(session: Session, establishment_id: int) -> int:
+    sy = (
+        session.query(SchoolYear)
+        .filter(SchoolYear.establishment_id == establishment_id)
+        .order_by(SchoolYear.id.desc())
+        .first()
+    )
+    if sy is None:
+        raise HTTPException(
+            status_code=404,
+            detail="No school year found for the current establishment",
+        )
+    return sy.id
+
+
+def _resolve_time_slot(
+    session: Session,
+    establishment_id: int,
+    day_of_week: int,
+    start: dtime,
+    end: dtime,
+) -> TimeSlot:
+    """Find an existing non-break TimeSlot matching the exact hours, or
+    create one at the end of the day's slot order."""
+    if start >= end:
+        raise HTTPException(
+            status_code=400, detail="start_time must be before end_time"
+        )
+
+    candidates = (
+        session.query(TimeSlot)
+        .filter(
+            TimeSlot.establishment_id == establishment_id,
+            TimeSlot.day_of_week == day_of_week,
+            TimeSlot.start_time == start,
+            TimeSlot.end_time == end,
+            TimeSlot.is_break == False,  # noqa: E712
+        )
+        .all()
+    )
+    for slot in candidates:
+        return slot
+
+    max_order = (
+        session.query(TimeSlot.slot_order)
+        .filter(
+            TimeSlot.establishment_id == establishment_id,
+            TimeSlot.day_of_week == day_of_week,
+        )
+        .order_by(TimeSlot.slot_order.desc())
+        .first()
+    )
+    next_order = (max_order[0] + 1) if max_order else 1
+    return ScheduleService.create_time_slot(
+        session,
+        establishment_id=establishment_id,
+        day_of_week=day_of_week,
+        slot_order=next_order,
+        start_time=start,
+        end_time=end,
+    )
+
+
+def _entry_payload(entry: ScheduleEntry) -> dict:
+    """Serialize one entry in the same format as GET /schedule."""
+    time_slot = entry.time_slot
+    sched_session = entry.session
+    class_subj = sched_session.class_subject if sched_session else None
+    subject = class_subj.subject if class_subj else None
+    teacher = class_subj.assigned_teacher if class_subj else None
+    classroom = class_subj.classroom if class_subj else None
+    return {
+        "id": entry.id,
+        "classroom_id": classroom.id if classroom else None,
+        "classroom_name": classroom.name if classroom else None,
+        "subject_id": class_subj.subject_id if class_subj else None,
+        "subject_name": subject.name if subject else None,
+        "subject_code": subject.code if subject else None,
+        "teacher_id": teacher.id if teacher else None,
+        "teacher_name": (
+            f"{teacher.prenoms or ''} {teacher.nom or ''}".strip()
+            if teacher
+            else None
+        ),
+        "time_slot_id": time_slot.id if time_slot else None,
+        "day_of_week": time_slot.day_of_week if time_slot else None,
+        "start_time": (
+            time_slot.start_time.strftime("%H:%M") if time_slot and time_slot.start_time else ""
+        ),
+        "end_time": (
+            time_slot.end_time.strftime("%H:%M") if time_slot and time_slot.end_time else ""
+        ),
+        "room": sched_session.room if sched_session else None,
+        "week_type": getattr(entry, "week_type", None),
+    }
+
+
+@router.post(
+    "/entries",
+    dependencies=[Depends(require_permission_api("CLASSROOM_MANAGE"))],
+)
+def create_schedule_entry_endpoint(
+    payload: ScheduleEntryCreateRequest,
+    current_user: User = Depends(get_current_user),
+    session: Session = Depends(get_db),
+):
+    """Create a schedule entry (admin only).
+
+    Reuses/creates the ScheduleSession for the class subject + current
+    school year, resolves the TimeSlot from the hours, and runs the
+    classroom + teacher conflict detection (same rules as the desktop).
+    """
+    from getech_sms.core.security import current_establishment_id
+
+    est_id = current_establishment_id()
+    if est_id is None:
+        raise HTTPException(status_code=400, detail="No establishment context")
+
+    cs = session.get(ClassSubject, payload.class_subject_id)
+    if cs is None:
+        raise HTTPException(status_code=404, detail="Class subject not found")
+    if cs.classroom_id != payload.classroom_id:
+        raise HTTPException(
+            status_code=400,
+            detail="class_subject_id does not belong to classroom_id",
+        )
+
+    week = payload.week_type
+    if week not in (None, "A", "B"):
+        raise HTTPException(
+            status_code=400, detail="week_type must be A, B or null"
+        )
+
+    start = _parse_hhmm(payload.start_time)
+    end = _parse_hhmm(payload.end_time)
+
+    school_year_id = _resolve_school_year_id(session, est_id)
+    time_slot = _resolve_time_slot(
+        session, est_id, payload.day_of_week, start, end
+    )
+
+    # Reuse the session for this class subject + year (update room if given).
+    sched_session = (
+        session.query(ScheduleSession)
+        .filter(
+            ScheduleSession.class_subject_id == cs.id,
+            ScheduleSession.school_year_id == school_year_id,
+            ScheduleSession.is_active == True,  # noqa: E712
+        )
+        .first()
+    )
+    if sched_session is None:
+        sched_session = ScheduleService.create_schedule_session(
+            session,
+            class_subject_id=cs.id,
+            school_year_id=school_year_id,
+            room=payload.room,
+        )
+    elif payload.room and payload.room != sched_session.room:
+        sched_session.room = payload.room
+
+    try:
+        entry = ScheduleService.create_schedule_entry(
+            session,
+            session_id=sched_session.id,
+            time_slot_id=time_slot.id,
+            week_type=week,
+        )
+    except ValueError as exc:
+        session.rollback()
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+
+    session.commit()
+    session.refresh(entry)
+    return _entry_payload(entry)
+
+
+@router.put(
+    "/entries/{entry_id}",
+    dependencies=[Depends(require_permission_api("CLASSROOM_MANAGE"))],
+)
+def update_schedule_entry_endpoint(
+    entry_id: int,
+    payload: ScheduleEntryUpdateRequest,
+    current_user: User = Depends(get_current_user),
+    session: Session = Depends(get_db),
+):
+    """Update a schedule entry (admin only): time slot, week type or room."""
+    from getech_sms.core.security import current_establishment_id
+
+    est_id = current_establishment_id()
+    entry = session.get(ScheduleEntry, entry_id)
+    if entry is None or not entry.is_active:
+        raise HTTPException(status_code=404, detail="Schedule entry not found")
+
+    sched_session = entry.session
+    if sched_session is None:
+        raise HTTPException(status_code=404, detail="Schedule session not found")
+
+    # Week type.
+    if payload.week_type is not None:
+        if payload.week_type not in ("A", "B"):
+            raise HTTPException(
+                status_code=400, detail="week_type must be A or B"
+            )
+        entry.week_type = payload.week_type
+
+    # Room.
+    if payload.room is not None:
+        sched_session.room = payload.room
+
+    # Time slot / day / hours.
+    day = payload.day_of_week or (entry.time_slot.day_of_week if entry.time_slot else None)
+    if payload.start_time or payload.end_time or payload.day_of_week or payload.time_slot_id:
+        if payload.time_slot_id is not None:
+            new_slot = session.get(TimeSlot, payload.time_slot_id)
+            if new_slot is None:
+                raise HTTPException(status_code=404, detail="Time slot not found")
+        else:
+            if est_id is None:
+                raise HTTPException(status_code=400, detail="No establishment context")
+            if day is None:
+                raise HTTPException(status_code=400, detail="day_of_week required")
+            current_slot = entry.time_slot
+            start = (
+                _parse_hhmm(payload.start_time)
+                if payload.start_time
+                else (current_slot.start_time if current_slot else None)
+            )
+            end = (
+                _parse_hhmm(payload.end_time)
+                if payload.end_time
+                else (current_slot.end_time if current_slot else None)
+            )
+            if start is None or end is None:
+                raise HTTPException(
+                    status_code=400, detail="start_time and end_time required"
+                )
+            new_slot = _resolve_time_slot(session, est_id, day, start, end)
+
+        # Conflict check (excluding this entry) — mirrors the desktop.
+        try:
+            conflicts = ScheduleService.detect_conflicts(
+                session,
+                classroom_id=sched_session.class_subject.classroom_id,
+                time_slot_id=new_slot.id,
+                week_type=entry.week_type,
+                school_year_id=sched_session.school_year_id,
+                exclude_entry_id=entry.id,
+            )
+            if conflicts:
+                raise ValueError(
+                    f"Conflit d'emploi du temps : le créneau est déjà occupé "
+                    f"par « {conflicts[0]['subject_name']} »."
+                )
+            assigned_teacher_id = (
+                sched_session.class_subject.assigned_teacher_id
+            )
+            if assigned_teacher_id is not None:
+                teacher_conflicts = ScheduleService.detect_teacher_conflicts(
+                    session,
+                    teacher_id=assigned_teacher_id,
+                    time_slot_id=new_slot.id,
+                    week_type=entry.week_type,
+                    school_year_id=sched_session.school_year_id,
+                    exclude_entry_id=entry.id,
+                )
+                if teacher_conflicts:
+                    raise ValueError(
+                        "Conflit d'emploi du temps : l'enseignant a déjà un "
+                        "cours sur ce créneau."
+                    )
+        except ValueError as exc:
+            session.rollback()
+            raise HTTPException(status_code=409, detail=str(exc)) from exc
+
+        entry.time_slot_id = new_slot.id
+
+    session.commit()
+    session.refresh(entry)
+    return _entry_payload(entry)
+
+
+@router.delete(
+    "/entries/{entry_id}",
+    dependencies=[Depends(require_permission_api("CLASSROOM_MANAGE"))],
+)
+def delete_schedule_entry_endpoint(
+    entry_id: int,
+    current_user: User = Depends(get_current_user),
+    session: Session = Depends(get_db),
+):
+    """Delete a schedule entry (admin only)."""
+    entry = session.get(ScheduleEntry, entry_id)
+    if entry is None or not entry.is_active:
+        raise HTTPException(status_code=404, detail="Schedule entry not found")
+    ScheduleService.delete_schedule_entry(session, entry_id)
+    session.commit()
+    return {"message": "Schedule entry deleted"}
